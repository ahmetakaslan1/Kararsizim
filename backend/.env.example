SECRET_KEY=django-insecure-change-this-in-production-kararsiz-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_HOST=db.your_project_id.supabase.co
DB_PORT=5432

# Supabase API
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Email (Resend SMTP) Settings
RESEND_API_KEY=your_resend_api_key_here
DEFAULT_FROM_EMAIL=info@yourdomian
FRONTEND_URL=http://127.0.0.1:5500/frontend
